<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="400.0" spacing="10.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label prefHeight="17.0" prefWidth="250.0" text="Number Of Slots" />
        <Spinner fx:id="numSlotsInput" editable="false" maxWidth="250.0">
            <valueFactory>
                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="3" initialValue="1" />
            </valueFactory>
            <VBox.margin>
                <Insets bottom="5.0" />
            </VBox.margin>
        </Spinner>
        <Label prefHeight="17.0" prefWidth="250.0" text="Number Of Hours Per Slot" />
        <Spinner fx:id="numHoursInput" editable="false" maxWidth="250.0">
            <valueFactory>
                <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="3" initialValue="1" />
            </valueFactory>
            <VBox.margin>
                <Insets bottom="5.0" />
            </VBox.margin>
        </Spinner>
        <HBox alignment="CENTER" prefHeight="40.0" prefWidth="200.0" spacing="20.0">
            <children>
                <Button fx:id="modify" mnemonicParsing="false" text="Modify" />
                <Button fx:id="cancel" mnemonicParsing="false" text="Cancel" />
            </children>
        </HBox>
        <Label fx:id="status" />
